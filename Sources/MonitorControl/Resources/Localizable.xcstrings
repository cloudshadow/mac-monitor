    "background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the window keeps monitoring active. Quit (⌘Q) stops this session. The boot preference and current service are controlled independently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口会继续监控；退出（⌘Q）会停止本次监控。开机启动和当前服务运行状态独立控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗會繼續監控；結束（⌘Q）會停止本次監控。開機啟動和目前服務執行狀態各自控制。"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover damaged account state (preserves history)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复损坏的账户状态（保留历史）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原損壞的帳戶狀態（保留歷史）"
          }
        }
      }
    },
    "deleteData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete saved account, history and TLS data when uninstalling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载时删除已保存的账户、历史和 TLS 数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝時刪除已儲存的帳戶、歷史及 TLS 資料"
          }
        }
      }
    },
    "serviceState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at boot: %1$@ · Service running: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机启动：%1$@ · 服务运行：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開機啟動：%1$@ · 服務執行：%2$@"
          }
        }
      }
    },
    "yes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
