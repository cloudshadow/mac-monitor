    },
    "copyCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy install command"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制安装命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製安裝指令"
          }
        }
      }
    },
    "background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the window keeps monitoring active. Quit (⌘Q) stops monitoring for this session; the boot preference is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口会继续后台监测；退出（⌘Q）会停止本次监测，保留开机启动设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗會繼續背景監測；退出（⌘Q）會停止本次監測，保留開機啟動設定。"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover damaged account state (preserves history)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复损坏的账户状态（保留历史）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原損壞的帳戶狀態（保留歷史）"
          }
        }
      }
    },
    "deleteData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete saved account, history and TLS data when uninstalling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载时删除已保存的账户、历史和 TLS 数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝時刪除已儲存的帳戶、歷史及 TLS 資料"
          }
        }
      }
    },
    "serviceState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boot preference %1$@ · system enabled %4$@ · loaded %2$@ · running %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机偏好 %1$@ · 系统启用 %4$@ · 已加载 %2$@ · 运行中 %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開機偏好 %1$@ · 系統啟用 %4$@ · 已載入 %2$@ · 執行中 %3$@"
          }
        }
      }
    },
    "yes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "no": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否"
          }
        }
      }
    },
    "refreshHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the monitor address, network interfaces, and recording status. This does not restart the service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查询监测地址、网络接口和记录状态，不会重启服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查詢監測位址、網路介面和記錄狀態，不會重新啟動服務。"
          }
        }
      }
    },
    "lanInterface": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network interface"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网接口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路介面"
          }
        }
      }
    },
    "lanHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For phones and other computers on the same network: choose an interface, enable LAN, then create a pairing code. Local monitoring works with LAN disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供同一网络的手机或其他电脑访问：选择接口，开启局域网，再生成配对码。本机监测无需开启局域网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供同一網路的手機或其他電腦存取：選擇介面，開啟區域網路，再產生配對碼。本機監測無需開啟區域網路。"
          }
        }
      }
    },
    "disableLAN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable LAN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭局域网"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉區域網路"
          }
        }
      }
    },
    "quitFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoring could not be stopped. The app remains open; use Stop service or retry quitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能停止监测，应用保持打开。请使用“停止服务”或重试退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能停止監測，應用程式保持開啟。請使用「停止服務」或重試退出。"
          }
        }
      }
    }
  },
  "version": "1.0"
}