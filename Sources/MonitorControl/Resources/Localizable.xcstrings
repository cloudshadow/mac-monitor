          "stringUnit": {
            "state": "translated",
            "value": "操作未完成（%1$@）。"
          }
        }
      }
    },
    "browserFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser could not be opened. Copy the monitor address into your browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开浏览器，请将监控地址复制到浏览器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟瀏覽器，請將監控地址複製到瀏覽器。"
          }
        }
      }
    },
    "lanUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN on en0 is unavailable (%1$@); local monitoring remains available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "en0 局域网暂不可用（%1$@），本机监控仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "en0 區域網路暫時無法使用（%1$@），本機監控仍可使用。"
          }
        }
      }
    },
    "certificate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS CA certificate: %1$@"
          }
        },
        "zh-Hans": {
