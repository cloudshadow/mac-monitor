    "no": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否"
          }
        }
      }
    },
    "refreshHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the monitor address, network interfaces, and recording status. This does not restart the service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查询监测地址、网络接口和记录状态，不会重启服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查詢監測位址、網路介面和記錄狀態，不會重新啟動服務。"
          }
        }
      }
    },
    "lanHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LAN access is enabled automatically on en0. Sign in with the same account and password. Other devices must trust this Mac’s local CA certificate for HTTPS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网默认在 en0 开启，使用相同账号密码登录。其他设备首次使用 HTTPS 时需信任这台 Mac 的本地 CA 证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路預設在 en0 開啟，使用相同帳號密碼登入。其他裝置首次使用 HTTPS 時需信任這台 Mac 的本機 CA 憑證。"
          }
        }
      }
    },
    "quitFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service did not confirm shutdown (%1$@). The control window will close; monitoring may still be running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务未确认停止（%1$@）。控制窗口将关闭，监控可能仍在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景服務未確認停止（%1$@）。控制視窗將關閉，監控可能仍在執行。"
          }
        }
      }
    },
    "version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %2$@ · build %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %2$@ · 构建 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %2$@ · 建置 %1$@"
          }
        }
      }
    },
    "serviceUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The monitoring service is unavailable (%1$@). Click Start service to resume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监控服务暂不可用（%1$@），请点击“启动服务”恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監控服務暫時無法使用（%1$@），請點選「啟動服務」恢復。"
          }
        }
      }
    },
    "actionFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete this action (%1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成（%1$@）。"
