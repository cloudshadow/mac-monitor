          }
        }
      }
    },
    "applyPort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply port"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用端口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用連接埠"
          }
        }
      }
    },
    "portHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one port (1–65535) for local HTTP and LAN HTTPS. Changes take effect immediately and are saved for the next start. Reopen the monitor after changing the port."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 HTTP 与局域网 HTTPS 共用端口（1–65535）。修改后立即生效并保存，下次启动沿用。修改后请重新打开监测页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機 HTTP 與區域網路 HTTPS 共用連接埠（1–65535）。修改後立即生效並儲存，下次啟動沿用。修改後請重新開啟監測頁面。"
          }
        }
      }
    },
    "invalidPort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole port number from 1 to 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 1 到 65535 之间的整数端口号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 1 到 65535 之間的整數連接埠號碼。"
          }
        }
      }
    },
    "localPortInUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local port %1$@ is already in use. Choose another port; the current configuration remains active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
